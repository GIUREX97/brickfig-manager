{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/tailwind.js", "dest": "/tailwind.js" },
    { "src": "/fallback.css", "dest": "/fallback.css" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
